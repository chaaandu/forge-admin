# Copy to .env.local and fill in. .env.local is gitignored.

# The service account that has Viewer on both sheets.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# The "private_key" field from the service account's JSON key, on one line,
# with its \n sequences left as they are, in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The long ID in each sheet's URL: docs.google.com/spreadsheets/d/<THIS>/edit
MASTER_SHEET_ID=
MENTOR_SHEET_ID=

# Google sign-in (Auth.js): the OAuth client, and a random string that signs sessions.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
# Production only: the public address of the auth routes.
# AUTH_URL=https://fb.mesaschool.co.in/admin/api/auth
